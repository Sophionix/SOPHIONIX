# =============================================================================
# Sophionix V3 — Environment Variables
# Copy this file to .env and fill in real values before running.
# =============================================================================

# ---- Runtime -----------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Docker Compose overrides ------------------------------------------------
# These control the compose service configuration. The app's DATABASE_URL and
# REDIS_URL are set automatically by compose to point at container hostnames.
DB_ROOT_PASSWORD=sophionix_root
DB_NAME=sophionix
DB_USER=sophionix
DB_PASSWORD=sophionix_dev
DB_PORT=3306
REDIS_PORT=6379
HTTP_PORT=80
APP_PORT=3000

# ---- MySQL / Prisma ----------------------------------------------------------
DATABASE_URL=mysql://sophionix:sophionix_dev@localhost:3306/sophionix?connection_limit=10

# ---- Redis (omit to use in-memory fallback; set when running via Docker) -----
# REDIS_URL=redis://localhost:6379

# ---- Auth.js v5 --------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_AUTH_SECRET
AUTH_TRUST_HOST=true

# Google OAuth 2.0
AUTH_GOOGLE_ID=CHANGE_ME.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET

# Apple Sign-In (optional)
AUTH_APPLE_ID=com.sophionix.web
AUTH_APPLE_TEAM_ID=CHANGE_ME_APPLE_TEAM_ID
AUTH_APPLE_KEY_ID=CHANGE_ME_APPLE_KEY_ID
AUTH_APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----"

# ---- Admin 2FA / crypto -----------------------------------------------------
TOTP_SECRET_KEY=CHANGE_ME_TOTP_SECRET
TOTP_ISSUER=Sophionix

# ---- WebAuthn ----------------------------------------------------------------
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Sophionix
WEBAUTHN_ORIGIN=http://localhost:3000
FEATURE_WEBAUTHN=true

# ---- reCAPTCHA v3 ------------------------------------------------------------
RECAPTCHA_SECRET_KEY=CHANGE_ME_RECAPTCHA_SECRET
RECAPTCHA_MIN_SCORE=0.5

# ---- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_API_VERSION=2024-12-18.acacia
CARD_UNLOCK_PRICE_CENTS=199
CARD_UNLOCK_CURRENCY=USD
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/billing/cancel

# ---- Firebase (optional — needed for FCM push notifications only) ------------
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# ---- AWS S3 storage (card art, avatars, voice notes) -------------------------
# Credentials resolve from the AWS default chain (~/.aws locally, IAM role in
# prod) — NEVER put AWS access keys in env. S3_ACCESS_URL is the CloudFront URL.
S3_BUCKET=your-bucket-name
S3_REGION=us-east-2
S3_ACCESS_URL=https://your-distribution.cloudfront.net
UPLOAD_URL_TTL=600

# Client-side Firebase (public keys)
NEXT_PUBLIC_FIREBASE_API_KEY=CHANGE_ME
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=CHANGE_ME
NEXT_PUBLIC_FIREBASE_APP_ID=CHANGE_ME
NEXT_PUBLIC_FIREBASE_VAPID_KEY=CHANGE_ME

# ---- Upload limits -----------------------------------------------------------
UPLOAD_MAX_AVATAR_BYTES=5242880
UPLOAD_MAX_CARD_ART_BYTES=8388608
UPLOAD_MAX_VOICE_BYTES=8388608
UPLOAD_MAX_VOICE_DURATION_MS=1200000

# ---- Email (optional) -------------------------------------------------------
# EMAIL_FROM="Sophionix <no-reply@sophionix.app>"
# EMAIL_REPLY_TO=support@sophionix.app
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=CHANGE_ME
# SMTP_PASSWORD=CHANGE_ME
MAILER_TRANSPORT=smtp

# ---- Cron --------------------------------------------------------------------
CRON_SECRET=CHANGE_ME_CRON_SECRET

# ---- GDPR --------------------------------------------------------------------
GDPR_DELETION_GRACE_DAYS=30

# ---- Guest sessions ----------------------------------------------------------
GUEST_SESSION_SECRET=CHANGE_ME_GUEST_SECRET
GUEST_SESSION_TTL_DAYS=30

# ---- Seed admin account -----------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=admin@sophionix.app
SEED_SUPER_ADMIN_PASSWORD=CHANGE_ME

# ---- Docker Compose startup flags -------------------------------------------
# Set to "true" after initial deployment to skip migration/seed on restart.
# Migrations are safe to re-run (idempotent), but seed may duplicate analytics.
SKIP_MIGRATE=
SKIP_SEED=
